<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ficha de Triage</title>
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body>

<div class="container">
  <h1>Ficha de Triage – Hospital</h1>

  <form method="POST" action="/triage/predict">

    <!-- =========================
         A) DATOS DEL PACIENTE
    ========================== -->
    <h2>Datos del Paciente</h2>

    <label for="nombre">Apellido y Nombre</label>
    <input type="text" name="nombre" id="nombre" required>

    <label for="dni">DNI</label>
    <input type="text" name="dni" id="dni" required>

    <label for="motivo">Motivo de consulta</label>
    <input type="text" name="motivo" id="motivo" required>

    <!-- =========================
         B) SIGNOS VITALES (DEMO)
    ========================== -->
    <h2>Signos Vitales</h2>

    <label for="temperatura">Temperatura (°C)</label>
    <input type="number" step="0.1" name="temperatura" id="temperatura">

    <label for="frecuencia_respiratoria">Frecuencia Respiratoria (FR)</label>
    <input type="number" name="frecuencia_respiratoria" id="frecuencia_respiratoria">

    <label for="spo2">SatO2 / SpO2 (%)</label>
    <input type="number" name="spo2" id="spo2">

    <label for="fc">Frecuencia Cardíaca (FC)</label>
    <input type="number" name="fc" id="fc">

    <label for="pas">TA Sistólica (PAS)</label>
    <input type="number" name="pas" id="pas">

    <label for="dolor">Dolor (0–10)</label>
    <input type="number" min="0" max="10" name="dolor" id="dolor">

    <!-- =========================
         C) GLASGOW (DEMO)
    ========================== -->
    <h2>Escala de Glasgow</h2>

    <label for="glasgow_ocular">Ocular (1–4)</label>
    <input type="number" min="1" max="4" name="glasgow_ocular" id="glasgow_ocular">

    <label for="glasgow_verbal">Verbal (1–5)</label>
    <input type="number" min="1" max="5" name="glasgow_verbal" id="glasgow_verbal">

    <label for="glasgow_motora">Motora (1–6)</label>
    <input type="number" min="1" max="6" name="glasgow_motora" id="glasgow_motora">

    <!-- =========================
         D) MANCHESTER
    ========================== -->
    <h2>Codificación Manchester</h2>

    <label for="manchester_color">Color Manchester</label>
    <select name="manchester_color" id="manchester_color">
      <option value="">(Dejar vacío para sugerencia automática)</option>
      {% for opt in manchester_options %}
        <option value="{{ opt.value }}">{{ opt.label }} – {{ opt.minutes }} min</option>
      {% endfor %}
    </select>

    <p class="muted" style="margin-top:8px;">
      Si no elegís color, el sistema sugiere uno (demo) según signos vitales.
</div>
    </p>
<!-- =========================
     E) UBICACIÓN / SILUETA
========================== -->
<h2>Ubicación de Lesiones</h2>

<div style="display:flex; gap:30px; align-items:flex-start; margin-top:16px; flex-wrap:wrap;">

  <div>
    <p><strong>Silueta corporal</strong></p>
    <img src="/static/img/silueta_limpia_v1.png?v=1"
         alt="Silueta corporal"
         style="max-width:220px; width:100%;
                border:1px solid #ccc;
                border-radius:8px;
                padding:6px;
                background:#fff;">
  </div>

  <div style="flex:1; min-width:260px;">
    <label for="ubicacion_lesion">Observaciones / Marcación referencial</label>
    <textarea
      name="ubicacion_lesion"
      id="ubicacion_lesion"
      rows="6"
      style="width:100%;"
      placeholder="Ej: Dolor en hemitórax derecho, excoriación en rodilla izquierda, etc."
    ></textarea>
  </div>

</div>

    <!-- =========================
         F) SINIESTROS VIALES
    ========================== -->
    <h2>Siniestros Viales</h2>

    <label for="tipo_accidente">Tipo de accidente</label>
    <input type="text" name="tipo_accidente" id="tipo_accidente"
           placeholder="Moto / Auto / Peatón / etc.">

    <label for="mecanismo">Mecanismo / Cinemática</label>
    <input type="text" name="mecanismo" id="mecanismo"
           placeholder="Choque frontal, lateral, vuelco, caída, etc.">

    <label for="elementos_proteccion">Elementos de protección</label>
    <input type="text" name="elementos_proteccion" id="elementos_proteccion"
           placeholder="Casco, cinturón, etc.">

    <!-- =========================
         G) FIRMA DIGITAL
    ========================== -->
    <h2>Profesional Interviniente</h2>

    <label for="profesional">Usuario / Profesional</label>
    <input type="text" name="profesional" id="profesional" required>

    <label for="rol">Rol</label>
    <select name="rol" id="rol">
      <option value="ENFERMERIA">Enfermería</option>
      <option value="MEDICO">Médico</option>
      <option value="ADMIN">Administrativo</option>
    </select>

    <!-- =========================
         BOTONES
    ========================== -->
    <div style="margin-top:20px; display:flex; gap:10px; flex-wrap:wrap;">
      <button type="submit" class="btn">Registrar Triage</button>
      <a class="btn btn-muted" href="/registros">Ver registros</a>
      <a class="btn btn-muted" href="/medico">Panel médico</a>
      <a class="btn btn-muted" href="/directivos">Panel directivos</a>
    </div>

  </form>
</div>

</body>
</html>

