<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Ficha de Triage</title>
  <!-- Si tu login ya usa Bootstrap, esto lo va a heredar; si no, igual se ve prolijo -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <style>
    body {
      background-color: #f3f4f6;
    }
    .triage-card {
      max-width: 1000px;
      margin: 30px auto;
      box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12);
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
    }
    .section-title {
      font-weight: 600;
      font-size: 0.95rem;
      padding: 6px 10px;
      margin: 18px -16px 10px -16px;
      background: #eef2ff;
      border-top: 1px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
      color: #1d4ed8;
    }
    .small-label {
      font-size: 0.8rem;
      color: #6b7280;
    }
  </style>
</head>
<body>
  <div class="container py-4">
    <div class="triage-card p-4">
      <h2 class="mb-1 text-primary">Ficha de Triage</h2>
      <p class="text-muted mb-3 small-label">
        Historia clínica de guardia – Dirección de Emergencias Médicas (versión demo digital)
      </p>

      <form method="post" action="/triage">
        <!-- A. DATOS DEL PACIENTE -->
        <div class="section-title">A. Datos del paciente / administrativos</div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small-label">Apellido y nombre</label>
            <input type="text" name="nombre" class="form-control" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small-label">DNI</label>
            <input type="text" name="dni" class="form-control" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small-label">Edad (años)</label>
            <input type="number" name="edad" min="0" max="120" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label small-label">Domicilio</label>
            <input type="text" name="domicilio" class="form-control">
          </div>
          <div class="col-md-3">
            <label class="form-label small-label">Teléfono</label>
            <input type="text" name="telefono" class="form-control">
          </div>
          <div class="col-md-3">
            <label class="form-label small-label">Fecha y hora de ingreso</label>
            <input type="datetime-local" name="fecha_hora" class="form-control">
          </div>
        </div>

        <!-- MOTIVO DE CONSULTA -->
        <div class="mt-3">
          <label class="form-label small-label">Motivo de consulta / derivación</label>
          <textarea name="motivo" class="form-control" rows="2" required></textarea>
        </div>

        <!-- B. DATOS ASISTENCIALES / SIGNOS VITALES -->
        <div class="section-title">B. Datos asistenciales / signos vitales</div>
        <div class="row g-3">
          <div class="col-md-2">
            <label class="form-label small-label">P.A. sistólica (mmHg)</label>
            <input type="number" name="systolic_bp" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="form-label small-label">P.A. diastólica (mmHg)</label>
            <input type="number" name="diastolic_bp" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="form-label small-label">Frec. cardíaca (lpm)</label>
            <input type="number" name="heart_rate" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="form-label small-label">Temperatura (°C)</label>
            <input type="number" step="0.1" name="temperature" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="form-label small-label">SaO₂ (%)</label>
            <input type="number" name="sao2" class="form-control">
          </div>
          <div class="col-md-2">
            <label class="form-label small-label">Nivel de dolor (1–10)</label>
            <input type="number" name="pain_level" min="1" max="10" class="form-control" required>
          </div>
        </div>

        <!-- GLASGOW (simplificado) -->
        <div class="row g-3 mt-2">
          <div class="col-md-3">
            <label class="form-label small-label">Glasgow total</label>
            <input type="number" name="glasgow" min="3" max="15" class="form-control">
          </div>
          <div class="col-md-9">
            <label class="form-label small-label">Observaciones de conciencia</label>
            <input type="text" name="estado_conciencia" class="form-control" placeholder="Alerta, somnoliento, confuso, etc.">
          </div>
        </div>

        <!-- SINIESTROS VIALES -->
        <div class="section-title">Siniestros viales</div>
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label small-label">¿Accidente vial?</label>
            <select name="accidente_vial" class="form-select">
              <option value="no">No</option>
              <option value="si">Sí</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label small-label">Tipo de accidente</label>
            <select name="tipo_accidente" class="form-select">
              <option value="ninguno">Ninguno</option>
              <option value="moto">Moto</option>
              <option value="auto">Auto</option>
              <option value="peaton">Peatón</option>
              <option value="bicicleta">Bicicleta</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label small-label">Descripción breve del siniestro</label>
            <input type="text" name="descripcion_siniestro" class="form-control">
          </div>
        </div>

        <!-- ANTECEDENTES CLÍNICOS -->
        <div class="mt-3">
          <label class="form-label small-label">Antecedentes clínicos relevantes</label>
          <textarea name="antecedentes" class="form-control" rows="2" placeholder="DBT, HTA, cardiopatía, neurológico, etc."></textarea>
        </div>

        <!-- C. ACTUACIÓN MÉDICA -->
        <div class="section-title">C. Actuación médica / diagnóstico / tratamiento</div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small-label">Diagnóstico presuntivo</label>
            <textarea name="diagnostico_presuntivo" class="form-control" rows="2"></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label small-label">Tratamiento / conducta inicial</label>
            <textarea name="tratamiento" class="form-control" rows="2"></textarea>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-4">
            <label class="form-label small-label">Resolución</label>
            <select name="resolucion" class="form-select">
              <option value="">Seleccionar…</option>
              <option value="observacion">Queda en observación</option>
              <option value="alta">Alta hospital</option>
              <option value="internacion">Internación</option>
              <option value="traslado">Traslado</option>
              <option value="obito">Óbito</option>
            </select>
          </div>
          <div class="col-md-8">
            <label class="form-label small-label">Servicio / lugar de internación / traslado</label>
            <input type="text" name="internacion_en" class="form-control">
          </div>
        </div>

        <!-- BOTONES -->
        <div class="d-flex justify-content-between align-items-center mt-4">
          <a href="/login" class="btn btn-outline-secondary">Volver</a>
          <div>
            <button type="submit" class="btn btn-primary">
              Guardar ficha y calcular riesgo
            </button>
          </div>
        </div>

        <p class="text-muted small-label mt-3 mb-0">
          Esta versión digital respeta la estructura de la ficha en papel y agrega soporte de IA para estimar riesgo de hospitalización y siniestro vial.
        </p>
      </form>
    </div>
  </div>
</body>
</html>
